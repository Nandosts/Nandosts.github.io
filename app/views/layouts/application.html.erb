<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= titulo_pagina %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8" />
    <meta name="keywords" content="Fernando Melo, Desenvolvedor Web, Ruby on Rails, Software Engineer, Full Stack, Hotwire, JavaScript, PostgreSQL, React, Portfolio" />
    <meta name="author" content="Fernando Jorge Santos Melo" />
    <meta name="theme-color" content="#162421" />
    <meta name="description" content="<%= descricao_meta_pagina %>" />
    <link rel="canonical" href="<%= url_canonica_pagina %>" />

    <!-- Open Graph -->
    <meta property="og:title" content="<%= titulo_pagina %>" />
    <meta property="og:site_name" content="Fernando Melo | Portfolio Dev" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content="<%= descricao_meta_pagina %>" />
    <meta property="og:url" content="<%= url_canonica_pagina %>" />
    <meta property="og:image" content="https://i.imgur.com/SqX0Vw4.png" />
    <meta property="og:locale" content="<%= I18n.locale.to_s == 'en' ? 'en_US' : 'pt_BR' %>" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="<%= url_canonica_pagina %>" />
    <meta name="twitter:title" content="<%= titulo_pagina %>" />
    <meta name="twitter:description" content="<%= descricao_meta_pagina %>" />
    <meta name="twitter:image" content="https://i.imgur.com/SqX0Vw4.png" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Dados Estruturados Schema.org (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Fernando Jorge Santos Melo",
        "alternateName": "Fernando Melo",
        "url": "<%= url_canonica_pagina %>",
        "image": "https://i.imgur.com/SqX0Vw4.png",
        "jobTitle": "Engenheiro de Software & Desenvolvedor Full Stack",
        "sameAs": [
          "https://github.com/Nandosts"
        ],
        "knowsAbout": [
          "Ruby on Rails",
          "Hotwire",
          "JavaScript",
          "PostgreSQL",
          "MySQL",
          "Docker",
          "Engenharia de Software"
        ]
      }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" type="image/svg+xml" href="<%= image_path('logo.svg') %>" />
    <link rel="alternate icon" type="image/png" href="<%= image_path('icon.png') rescue '/icon.png' %>" />

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main>
      <%= render "shared/navbar" %>
      <%= yield %>
      <%= render "shared/footer" %>
    </main>
  </body>
</html>